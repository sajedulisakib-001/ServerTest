{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon.ico|sw\\.js|manifest\\.json|offline\\.html|no-image\\.svg|icons\\/|images\\/|css\\/|uploads\\/).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon.ico|sw\\.js|manifest\\.json|offline\\.html|no-image\\.svg|icons/|images/|css/|uploads/).*)"
        }
      ]
    }
  }
}